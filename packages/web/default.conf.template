# Plantilla: la imagen oficial de nginx la procesa al arrancar y reemplaza
# cada ${VARIABLE} por su valor de entorno, dejando el resultado en
# /etc/nginx/conf.d/default.conf. Así la MISMA imagen sirve en compose, en QA
# y en PROD: lo que cambia entre entornos llega por variables, no horneado.
#
#   PORT          puerto de escucha (80 en compose; Render impone el suyo)
#   DNS_RESOLVER  quién resuelve el nombre del backend (el DNS de Docker en
#                 compose, uno público en Render)
#   BACKEND_URL   dónde está la API de ESTE entorno, sin barra final

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Hace falta declararlo para poder resolver el upstream en tiempo de
    # ejecución (ver el comentario de abajo).
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # La API vive en otro contenedor. nginx la proxea bajo el mismo origen
    # para que el navegador no vea dos hosts y no haya CORS ni preflight.
    location ~ ^/(api|login|u|salud|webhook)/? {
        # El upstream va en una variable a propósito. Con el nombre literal,
        # nginx lo resuelve UNA VEZ al arrancar y aborta si no existe todavía
        # (`host not found in upstream`), quedando en loop de reinicio. Con
        # una variable la resolución pasa a ser en cada request, así que el
        # orden de arranque deja de importar y un reinicio de la API no
        # obliga a reiniciar nginx.
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;
        # En Render la API es https: sin SNI el TLS no sabe a qué host va.
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: cualquier ruta que no sea un archivo la resuelve el router del
    # cliente, así que se devuelve el index y no un 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
