# syntax=docker/dockerfile:1

# Imagen del frontend. Multi-stage clásico: Node compila la SPA, nginx la
# sirve. La imagen final no tiene Node ni el código fuente — solo estáticos.

# ---- Etapa 1: build ----
FROM node:26-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/core/package.json packages/core/
COPY packages/api/package.json packages/api/
COPY packages/web/package.json packages/web/
COPY packages/worker/package.json packages/worker/
RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages/web packages/web
RUN pnpm --filter @notia/web build

# ---- Etapa 2: nginx sirve los estáticos ----
FROM nginx:1.29-alpine AS runtime
# Va en templates/ y no en conf.d/: la imagen de nginx procesa las plantillas
# al arrancar y escribe el resultado en conf.d/. Si fuera directo a conf.d/,
# los ${…} quedarían sin reemplazar y nginx no arrancaría.
COPY packages/web/default.conf.template /etc/nginx/templates/default.conf.template
# Valores por defecto: los de compose. Un entorno de nube los pisa con los
# suyos (la URL de su API, un DNS público, el puerto que imponga).
ENV PORT=80 \
    DNS_RESOLVER=127.0.0.11 \
    BACKEND_URL=http://notia-api:3000
# vite.config.ts emite a ../api/public: el mismo artefacto sirve para los dos
# modos de despliegue (la API sirviéndolo en un solo proceso, o nginx acá).
COPY --from=build /app/packages/api/public /usr/share/nginx/html
EXPOSE 80
